generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  STUDENT
  ADMIN
  INSTRUCTOR
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum EnrollmentStatus {
  ENROLLED
  IN_PROGRESS
  COMPLETED
}

enum CorrectAnswer {
  A
  B
  C
  D
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id                 String     @id @default(cuid())
  fullName           String
  email              String     @unique
  passwordHash       String?
  googleId           String?    @unique
  image              String?
  role               Role       @default(STUDENT)
  profileImage       String?
  status             UserStatus @default(ACTIVE)
  lastLoginAt        DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  // Profile fields (optional, collected post-signup)
  country            String?
  organization       String?
  position           String?
  interestArea       String[]   @default([])
  learningGoal       String?
  isProfileCompleted Boolean    @default(false)

  // Relations
  courses        Course[]         @relation("InstructorCourses")
  enrollments    Enrollment[]
  lessonProgress LessonProgress[]
  quizAttempts   QuizAttempt[]
  certificates   Certificate[]

  @@index([email])
  @@index([role])
  @@index([googleId])
}

model Course {
  id               String       @id @default(cuid())
  title            String
  slug             String       @unique
  courseCode        String       @unique
  description      String       @db.Text
  shortDescription String?
  category         String
  level            CourseLevel  @default(BEGINNER)
  duration         String?
  thumbnail        String?
  isFree           Boolean      @default(true)
  hasCertificate   Boolean      @default(true)
  instructorId     String?
  status           CourseStatus @default(DRAFT)
  pathGroup        String?      // FOUNDATION, CORE, APPLIED, ADVANCED
  pathOrder        Int          @default(0)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  // Relations
  instructor          User?                @relation("InstructorCourses", fields: [instructorId], references: [id], onDelete: SetNull)
  lessons             Lesson[]
  enrollments         Enrollment[]
  quizzes             Quiz[]
  certificates        Certificate[]
  certificateTemplate CertificateTemplate?
  courseInstructors    CourseInstructor[]

  @@index([slug])
  @@index([category])
  @@index([status])
  @@index([instructorId])
  @@index([courseCode])
  @@index([pathGroup])
}

model Lesson {
  id               String      @id @default(cuid())
  courseId          String
  title            String
  subtitle         String?
  description      String?     @db.Text
  youtubeUrl       String?
  videoTitle       String?
  videoChannel     String?
  durationText     String?
  lessonOrder      Int
  lessonLevel      CourseLevel @default(BEGINNER)
  summary          String?     @db.Text
  learningOutcomes String?     @db.Text
  keyTakeaways     String?     @db.Text
  coverImage       String?     @db.Text
  isActive         Boolean     @default(true)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  // Relations
  course           Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessonProgress   LessonProgress[]
  resources        Resource[]
  ebook            LessonEbook?
  inVideoQuizzes   InVideoQuizQuestion[]

  @@index([courseId])
  @@index([courseId, lessonOrder])
}

model InVideoQuizQuestion {
  id            String        @id @default(cuid())
  lessonId      String
  question      String        @db.Text
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctAnswer CorrectAnswer
  explanation   String?       @db.Text
  triggerPercent Int          @default(50) // % of video duration when question pops up (1-99)
  sortOrder     Int           @default(0)
  createdAt     DateTime      @default(now())

  // Relations
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
  @@index([lessonId, sortOrder])
}

model Enrollment {
  id              String           @id @default(cuid())
  userId          String
  courseId         String
  progressPercent Float            @default(0)
  status          EnrollmentStatus @default(ENROLLED)
  enrolledAt      DateTime         @default(now())
  completedAt     DateTime?

  // Relations
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@index([status])
}

model LessonProgress {
  id           String    @id @default(cuid())
  userId       String
  lessonId     String
  completed    Boolean   @default(false)
  completedAt  DateTime?
  lastViewedAt DateTime  @default(now())

  // Relations
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
}

model Quiz {
  id           String   @id @default(cuid())
  courseId      String
  title        String
  passingScore Int      @default(70)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  course    Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questions QuizQuestion[]
  attempts  QuizAttempt[]

  @@index([courseId])
}

model QuizQuestion {
  id            String        @id @default(cuid())
  quizId        String
  question      String        @db.Text
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctAnswer CorrectAnswer
  explanation   String?       @db.Text
  difficulty    CourseLevel   @default(BEGINNER)
  sortOrder     Int

  // Relations
  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
  @@index([quizId, sortOrder])
}

model QuizAttempt {
  id          String   @id @default(cuid())
  userId      String
  quizId      String
  score       Int
  passed      Boolean
  attemptedAt DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([quizId])
  @@index([userId, quizId])
}

model Certificate {
  id              String   @id @default(cuid())
  certificateCode String   @unique
  userId          String
  courseId         String
  themeId         String   @default("executive-navy")
  issuedAt        DateTime @default(now())
  completionDate  DateTime @default(now())
  certificateUrl  String?
  verificationUrl String?
  qrCodeUrl       String?
  pdfUrl          String?

  // Relations
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([certificateCode])
  @@index([userId])
  @@index([courseId])
}

model CertificateTemplate {
  id                 String   @id @default(cuid())
  courseId            String   @unique
  logoUrl            String?
  signatureUrl       String?
  signerName         String   @default("ผศ.ดร.รวิภา อัครจินดานนท์")
  signerTitle        String   @default("คณบดีคณะบริหารธุรกิจ มหาวิทยาลัยศรีปทุม")
  backgroundTemplate String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Relations
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model CertificateSettings {
  id               String   @id @default("global")
  logoUrl          String?
  signatureUrl     String?
  signerName       String   @default("ผศ.ดร.รวิภา อัครจินดานนท์")
  signerTitle      String   @default("คณบดีคณะบริหารธุรกิจ มหาวิทยาลัยศรีปทุม")
  certificatePrefix   String   @default("SPUBUS")
  defaultThemeId      String   @default("executive-navy")
  enabledThemes       String[] @default(["executive-navy", "royal-blue-data", "elegant-gold", "minimal-white", "academic-crimson", "ai-circuit", "business-flow"])
  verificationBaseUrl String   @default("")
  enableQrCode        Boolean  @default(true)
  updatedAt           DateTime @updatedAt
}

model Resource {
  id        String   @id @default(cuid())
  lessonId  String
  fileName  String
  fileUrl   String
  fileType  String
  createdAt DateTime @default(now())

  // Relations
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
}

model LessonEbook {
  id                  String   @id @default(cuid())
  lessonId            String   @unique
  title               String?
  subtitle            String?
  coverImageUrl       String?
  introduction        String?  @db.Text
  keyConcepts         String?  @db.Text
  businessUseCases    String?  @db.Text
  toolsAndTechniques  String?  @db.Text
  practicalExample    String?  @db.Text
  ebookSummary        String?  @db.Text
  ebookKeyTakeaways   String?  @db.Text
  reviewQuestions     String?  @db.Text
  closingMessage      String?  @db.Text
  pdfUrl              String?
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relations
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
}

model EbookSettings {
  id                 String   @id @default("global")
  watermarkText      String   @default("AI Business Academy | คณะบริหารธุรกิจ ม.ศรีปทุม")
  watermarkOpacity   Float    @default(0.15)
  headerText         String   @default("AI Business Academy")
  footerText         String   @default("คณะบริหารธุรกิจ มหาวิทยาลัยศรีปทุม")
  logoUrl            String?
  isWatermarkEnabled Boolean  @default(true)
  accentColor        String   @default("#1e40af")
  updatedAt          DateTime @updatedAt
}

model WebsiteContent {
  id          String   @id @default(cuid())
  sectionName String   @unique
  contentJson Json
  updatedAt   DateTime @updatedAt

  @@index([sectionName])
}

model Testimonial {
  id              String  @id @default(cuid())
  name            String
  role            String
  companyOrStatus String
  message         String  @db.Text
  avatarUrl       String?
  isActive        Boolean @default(true)
  sortOrder       Int     @default(0)

  @@index([isActive, sortOrder])
}

model FAQ {
  id        String  @id @default(cuid())
  question  String  @db.Text
  answer    String  @db.Text
  sortOrder Int
  isActive  Boolean @default(true)

  @@index([isActive, sortOrder])
}

model Instructor {
  id           String   @id @default(cuid())
  name         String
  title        String
  bio          String?  @db.Text
  profileImage String?
  expertise    String[] @default([])
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  courses CourseInstructor[]

  @@index([isActive, sortOrder])
}

model CourseInstructor {
  id           String @id @default(cuid())
  courseId      String
  instructorId String

  course     Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  instructor Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  @@unique([courseId, instructorId])
  @@index([courseId])
  @@index([instructorId])
}
